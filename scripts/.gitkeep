{
  "triggers": [
    {
      "name": "free",
      "query": "free",
      "output_folder": "data/raw/free",
      "filtered_folder": "data/filtered/free",
      "description": "Все репозитории со словом 'free'"
    },
    {
      "name": "ai",
      "query": "ai",
      "output_folder": "data/raw/ai",
      "filtered_folder": "data/filtered/ai",
      "description": "Все репозитории со словом 'ai'"
    },
    {
      "name": "free_ai",
      "query": "\"free ai\"",
      "output_folder": "data/raw/free-ai",
      "filtered_folder": "data/filtered/free-ai",
      "description": "Репозитории с точным совпадением 'free ai' (основной триггер)",
      "priority": true
    }
  ],
  "github": {
    "min_stars": 50,
    "languages": ["python", "javascript", "typescript"],
    "sort_by": "stars",
    "order": "desc",
    "per_page": 30
  },
  "ai_filter": {
    "enabled": true,
    "model": "qwen:7b",
    "api_type": "ollama",
    "api_url": "http://localhost:11434/api/generate",
    "token_limit": 4000,
    "spam_keywords": ["crypto", "bitcoin", " scam", "paid", "subscription", "OnlyFans", "cam", "porn", "adult"],
    "min_quality_score": 6
  },
  "schedule": "0 0 * * *"
}
